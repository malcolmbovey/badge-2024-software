# Copy this file to .env (in this same directory) and fill in your details.
# .env is gitignored, so your coordinates won't be committed.

# Your current location, in decimal degrees. Used as the centre point for
# the nearest-plane search until a GPS sensor is wired up (see location.py).
FLIGHT_HOME_LAT=51.368924
FLIGHT_HOME_LON=-0.310054

# Optional: how far out to search for aircraft, in kilometres. The feed is
# queried over a square box of this half-width centred on your location;
# raise it in quieter airspace, lower it somewhere busy like under a
# major airport's approach path.
FLIGHT_RADIUS_KM=50

# Optional: how often to re-poll for the nearest plane, in seconds.
FLIGHT_REFRESH_SECONDS=60

# Optional: override the FlightRadar24 feed URL. Only needed if direct
# badge -> FR24 requests start getting blocked by Cloudflare (see README) and
# you've stood up a relay that re-serves the same JSON shape.
# FLIGHT_FEED_URL=https://data-cloud.flightradar24.com/zones/fcgi/feed.js
