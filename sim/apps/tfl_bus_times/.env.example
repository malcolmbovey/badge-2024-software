# Copy this file to .env (in this same directory) and fill in your details.
# .env is gitignored, so your details won't be committed.

# TfL StopPoint ID for the bus stop to show departures for.
# Find it by searching https://api.tfl.gov.uk/StopPoint/Search/<stop name>
# or from a stop's page on https://tfl.gov.uk/plan-a-journey/.
# Example below is The North Star, northbound (towards Surbiton/Kingston),
# near KT9 1PX.
TFL_STOP_ID=490013474N

# Optional: a TfL API key from https://api-portal.tfl.gov.uk/.
# Not required for light use of the public StopPoint/Arrivals endpoint, but
# recommended to avoid being rate-limited.
TFL_APP_KEY=

# Optional: how often to refresh the departure board, in seconds.
TFL_REFRESH_SECONDS=30
