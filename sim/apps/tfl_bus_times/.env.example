# Copy this file to .env (in this same directory) and fill in your details.
# .env is gitignored, so your details won't be committed.

# Comma-separated list of TfL StopPoint IDs for the bus stops to show
# departures for. Use the LEFT/RIGHT buttons to cycle between them; the
# red-LED "bus due soon" warning always applies to whichever stop is
# currently on screen, not the others.
# Find stop IDs by searching https://api.tfl.gov.uk/StopPoint/Search/<stop name>
# or from a stop's page on https://tfl.gov.uk/plan-a-journey/.
# Each entry can optionally have a custom label after a colon
# (id:Label) to override the stop name TfL returns, e.g. to shorten it.
# Example below is The North Star, northbound (towards Surbiton/Kingston),
# near KT9 1PX, followed by a second example stop with a custom label.
TFL_STOP_IDS=490013474N,490000234C:Home stop

# Legacy single-stop key, still read if TFL_STOP_IDS is unset.
# TFL_STOP_ID=490013474N

# Optional: a TfL API key from https://api-portal.tfl.gov.uk/.
# Not required for light use of the public StopPoint/Arrivals endpoint, but
# recommended to avoid being rate-limited.
TFL_APP_KEY=

# Optional: how often to refresh the departure board, in seconds.
TFL_REFRESH_SECONDS=30

# Optional: the LEDs turn red when a shown bus is due to depart within this
# window, in minutes. Defaults to 7-10 minutes.
TFL_URGENT_MIN_MINUTES=7
TFL_URGENT_MAX_MINUTES=10

# Optional: comma-separated list of route/line names to ignore when deciding
# whether to light the LEDs red (e.g. routes you don't want to catch).
TFL_EXCLUDED_ROUTES=467
